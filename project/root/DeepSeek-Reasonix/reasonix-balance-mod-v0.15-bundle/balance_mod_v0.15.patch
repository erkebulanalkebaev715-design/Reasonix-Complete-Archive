+					}
+					calledTool = true
+				} else if !emit(provider.Chunk{Type: provider.ChunkText, Text: "MOCK_DENY_NO_PROXY"}) {
+					return
+				}
+				break
+			}
+			if messagesContain(req.Messages, "denied by permission policy") || messagesContain(req.Messages, "blocked:") {
