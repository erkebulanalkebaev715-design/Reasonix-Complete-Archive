{
  "schema": "balance-real-provider-gate-v1",
  "modVersion": "balance-mod-v0.20",
  "baseline": "balance-mod-v0.19",
  "state": "locked-until-explicit-user-approval",
  "provider": {
    "name": "deepseek-v20",
    "kind": "openai",
    "baseUrl": "https://api.deepseek.com",
    "model": "deepseek-v4-flash",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "apiKeyEmbedded": false,
    "installerReadsApiKey": false,
    "proAllowed": false
  },
  "hardGate": {
    "approvalEnv": "BALANCE_V20_REAL_API_APPROVED",
    "approvalValue": "YES_I_EXPLICITLY_APPROVE_DEEPSEEK_API",
    "fxEnv": "BALANCE_V20_USD_KZT",
    "budgetEnv": "BALANCE_V20_BUDGET_KZT",
    "defaultBudgetKzt": 10.0,
    "maximumBudgetKzt": 25.0,
    "reservePercent": 20,
    "proMaxPercent": 0,
    "hardStop": true,
    "maxOutputTokens": 64,
    "failClosedOnMissingFX": true,
    "failClosedOnMissingApproval": true,
    "failClosedOnStalePricingSnapshot": true,
    "retryPolicy": "strict-one-paid-attempt-no-hidden-retry-v0.20-fixed9"
  },
  "pricingSnapshot": {
    "source": "DeepSeek official Models & Pricing (peak-rate conservative snapshot)",
    "asOf": "2026-08-21",
    "currency": "USD",
    "unitTokens": 1000000,
    "deepseek-v4-flash": {
      "cacheHit": 0.014,
      "input": 0.44,
      "output": 1.32
    },
    "maxAgeDays": 1
  },
  "reconciliation": {
    "providerReportedUsageRequired": true,
    "cacheHitMissAware": true,
    "backendSpentDeltaRequired": true,
    "absoluteToleranceKzt": 0.05,
    "relativeTolerance": 0.05,
    "note": "Exact provider Usage is captured at emitTurnUsage into a temporary gate-only receipt and independently reconciled against the backend KZT ledger. It is a rate-card estimate, not a wallet invoice.",
    "ledgerPricingPolicy": "official-flat-v4-flash",
    "usageReceipt": "agent.emitTurnUsage exact provider Usage -> env-gated atomic receipt v0.20-fixed12"
  },
  "requiredOfflineGates": [
    "v0.19-full-regression",
    "hard-precall-native-regression",
    "real-gate-default-locked",
    "no-secret-in-bundle",
    "pricing-reconciler-self-test",
    "real-config-build-preflight"
  ],
  "requiredRealGates": [
    "explicit-user-approval",
    "fresh-pricing-snapshot",
    "positive-explicit-usd-kzt-fx",
    "loopback-token-auth",
    "known-provider-pricing-before-stream",
    "hard-kzt-precall-gate",
    "strict-one-paid-attempt-policy",
    "flash-only-single-agent",
    "single-tiny-real-task",
    "provider-reported-usage",
    "actual-vs-ratecard-reconciliation",
    "spent-below-hard-budget"
  ]
}
