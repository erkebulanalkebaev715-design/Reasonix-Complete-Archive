+	}
+
+	bc2 := NewBroadcaster()
+	ctrl2 := control.New(control.Options{Sink: bc2, Registry: reg, WorkspaceRoot: root, SessionDir: filepath.Join(root, ".sessions"), ModelRef: "mock/flash"})
+	s2 := New(ctrl2, bc2, config.ServeConfig{})
