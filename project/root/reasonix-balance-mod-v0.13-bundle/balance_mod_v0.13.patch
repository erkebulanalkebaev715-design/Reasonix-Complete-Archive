+		StrategyID: "flash-a", FailureFingerprint: "fp-1", PatchNumstat: "1\t1\tx.go",
+		BuildLog: "SECRET_RAW_BUILD_LOG", FixHint: "SECRET_FIX_HINT",
+		Verification: efficiency.VerificationReceipt{RequiredChecks: 1, ChecksFailed: 1},
+	}
