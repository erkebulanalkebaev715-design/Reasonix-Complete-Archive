+// SetInboxObserver installs the APK-side observer for the native durable
+// session inbox. Broadcaster implements the optional InboxChanged sink
+// capability, so Controller queue transitions remain visible without polling
+// or introducing a second queue state machine.
+func (b *Broadcaster) SetInboxObserver(fn func(sessioninbox.InboxSnapshot)) {
+	if b == nil {
+		return
+	}
+	b.inboxObserverMu.Lock()
+	b.inboxObserver = fn
+	b.inboxObserverMu.Unlock()
+}
+
+func (b *Broadcaster) InboxChanged(snap sessioninbox.InboxSnapshot) {
+	if b == nil {
+		return
+	}
+	b.inboxObserverMu.RLock()
+	fn := b.inboxObserver
+	b.inboxObserverMu.RUnlock()
+	if fn != nil {
+		fn(snap)
+	}
+}
+
