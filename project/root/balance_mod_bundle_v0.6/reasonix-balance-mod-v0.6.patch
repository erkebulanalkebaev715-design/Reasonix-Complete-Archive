@@ -291,12 +291,16 @@ type Registry struct {
 	// schema. Nil means every registered tool is provider-visible (tests and
 	// legacy direct construction).
 	providerVisible map[string]bool
-	schemaRev       atomic.Uint64
+	// sessionHidden is a runtime-only deny projection used by APK/session
+	// policy. It trims denied tools from provider schemas without mutating the
+	// baseline providerVisible contract.
+	sessionHidden map[string]bool
+	schemaRev     atomic.Uint64
 }
 
 // NewRegistry returns an empty registry.
 func NewRegistry() *Registry {
-	return &Registry{tools: map[string]Tool{}, canon: map[string]json.RawMessage{}, suspended: map[string]bool{}}
+	return &Registry{tools: map[string]Tool{}, canon: map[string]json.RawMessage{}, suspended: map[string]bool{}, sessionHidden: map[string]bool{}}
 }
 
 // SetProviderVisibleTools restricts the provider-visible schema surface to the
@@ -351,12 +355,45 @@ func (r *Registry) ProviderVisible(name string) bool {
 }
 
 func (r *Registry) isProviderVisibleLocked(name string) bool {
+	if r.sessionHidden[name] {
+		return false
+	}
 	if r.providerVisible == nil {
 		return true
 	}
 	return r.providerVisible[name]
 }
 
+// SetSessionHiddenTools replaces the runtime-only provider-schema deny list.
+// Get/ResolveCall remain intact so the native permission gate is still the
+// authority for indirect use_capability dispatch.
+func (r *Registry) SetSessionHiddenTools(names []string) {
+	if r == nil {
+		return
+	}
+	next := map[string]bool{}
+	for _, name := range names {
+		if name = strings.TrimSpace(name); name != "" {
+			next[name] = true
+		}
+	}
+	r.mu.Lock()
+	changed := len(next) != len(r.sessionHidden)
+	if !changed {
+		for n := range next {
+			if !r.sessionHidden[n] {
+				changed = true
+				break
+			}
+		}
+	}
+	r.sessionHidden = next
+	if changed {
+		r.schemaRev.Add(1)
+	}
+	r.mu.Unlock()
+}
+
