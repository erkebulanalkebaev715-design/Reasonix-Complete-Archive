+	var cfg efficiency.ExecutionConfig
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&cfg); err != nil {
+		http.Error(w, "invalid execution config: "+err.Error(), http.StatusBadRequest)
