78:function projectSummaryBody(){const c=cur(),p=curProject(c);if(!p)return `<div class=sub>${I('noProject')}</div><div class=row><button class=btn id=plusChooseProject>${I('chooseProject')}</button><button class="btn primary" id=plusCreateProject>${I('createProject')}</button></div>`;const chatLinked=p.chatIds.includes(c.id);return `<div class=sub>${esc(p.name)}${p.path?` · ${esc(p.path)}`:''}</div><div class=row style="margin-bottom:10px"><button class=btn id=plusChooseProject>${I('chooseProject')}</button><button class=btn id=plusEditProject>${I('edit')}</button><button class="btn bad" id=plusDeleteProject>${I('delete')}</button></div><div class=field><label>${I('projectChats2')}</label><div class=card style="margin:0;padding:10px">${chatLinked?`<div class=row><div class=grow><b>${esc(c.title)}</b><p>${I('attached')}</p></div><button class=btn id=detachChatBtn>${I('detachCurrentChat')}</button></div>`:`<div class=row><div class=grow><b>${esc(c.title)}</b><p>${I('noChats')}</p></div><button class=btn id=attachChatBtn>${I('attachCurrentChat')}</button></div>`}</div></div><div class=field><label>${I('projectSources')}</label><div id=plusProjectSources>${p.sources.length?p.sources.map((x,i)=>`<div class=sheetRow data-del-source="${i}">↗ <div class=grow><b>${esc(x.label||x.url||'source')}</b><small>${esc(x.url||'')}</small></div><span>⌫</span></div>`).join(''):`<div class=sub>${I('noSources')}</div>`}<div class=row style="margin-top:8px"><input id=projectSourceInput placeholder="https://..." class=grow><button class=btn id=addSourceBtn>${I('addSource')}</button></div></div></div><div class=field><label>${I('projectFiles')}</label><div id=plusProjectFiles>${p.files.length?p.files.map((x,i)=>`<div class=sheetRow data-del-file="${i}">＋ <div class=grow><b>${esc(x.label||x.path||'file')}</b><small>${esc(x.path||'')}</small></div><span>⌫</span></div>`).join(''):`<div class=sub>${I('noFiles')}</div>`}<div class=row style="margin-top:8px"><input id=projectFileInput placeholde