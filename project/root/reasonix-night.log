 function compactNodes(nodes){const out=[];let i=0;while(i<nodes.length){let j=i+1;const a=nodes[i];while(j<nodes.length&&nodes[j].kind===a.kind&&nodes[j].title===a.title&&nodes[j].sub===a.sub&&!nodes[j].children?.length&&!a.children?.length&&nodes[j].state===a.state&&a.kind!=='reason'&&a.kind!=='phase')j++;if(j-i>=3){out.push({...a,count:j-i,children:nodes.slice(i,j)});i=j}else{out.push(a);i++}}return out}
