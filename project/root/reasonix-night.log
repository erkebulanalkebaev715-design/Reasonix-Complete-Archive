112:function swarmSummary(s){const running=s.status==='running'||s.status==='planned';const tasks=Object.values(s.tasks||{});const byProfile={};for(const t of tasks){const p=t.profile||I('agent');byProfile[p]=byProfile[p]||[0,0,0];if(t.status==='succeeded')byProfile[p][0]++;else if(t.status==='failed'||t.status==='cancelled')byProfile[p][1]++;else byProfile[p][2]++}const chips=Object.entries(byProfile).map(([p,c])=>`<span class=count>${esc(p)}${c[0]?' ✓'+c[0]:''}${c[2]?' …'+c[2]:''}${c[1]?' ✗'+c[1]:''}</span>`).join('');const sec=Math.max(1,Math.round((Date.now()-new Date(s.updatedAt).getTime())/1000));const status=running?I('swarmRunning')+' · '+sec+'s':esc(swarmStatusName(s.status));return `<div class="work ${running?'live':''}" data-swarm=1 data-id="${esc(s.id)}"><button class=workToggle><span class=spark>◈</span><div class=grow><div class=workTitle>${esc(s.objective||s.id)}</div><div class=workStatus>${status}${chips?' · '+chips:''}</div></div><span class=chev>⌄</span></button><div class=workBody><div class=workInner><div class=workContent>${swarmDetail(s)}</div></div></div></div>`}
