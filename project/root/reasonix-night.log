79:async function renderPlusTools(kind){const box=$(`#plusList_${kind}`);if(!box)return;if(!state.connected){box.innerHTML=`<div class=sub>${I('backendOff')}</div>`;return}box.innerHTML=`<div class=sub>${I('loading')}...</div>`;try{let items=[];if(kind==='skills'){const d=(await req('/mobile/skills',{timeoutMs:15000})).data||{};items=d.skills||[]}else{const d=(await req('/mobile/tools',{timeoutMs:15000})).data||{};const all=d.servers||[];items=kind==='plugins'?all.filter(x=>x.transport!=='stdio'):all.filter(x=>x.transport==='stdio')}const built=kind==='skills'?`<div class=sheetRow><span>✦</span><div class=grow><b>${I('builtins')}</b><small>Android developer · Debugger · Verifier · Web researcher · Project architect</small></div><button class=btn data-install-builtins>${I('installBuiltins')}</button></div>`:'';box.innerHTML=built+(items.length?items.map(x=>`<div class=sheetRow><div class=grow><b>${esc(x.name)}</b><small>${esc(x.description||x.command||x.url||'')}</small></div><button class="switch ${(x.enabled!==false)?'on':''}" data-plus-tool-toggle="${esc(x.name)}" data-kind="${kind==='skills'?'skill':'mcp'}"></button><button class=mini data-plus-edit="${esc(x.name)}" aria-label="${I('edit')}">✎</button><button class=mini data-plus-delete="${esc(x.name)}" aria-label="${I('delete')}">⌫</button></div>`).join(''):`<div class=sub>${I('nothingYet')}</div>`)+`<div class=row style="margin-top:8px"><button class="btn primary grow" data-plus-add="${kind}">${I('add')}</button></div>`;$('#plusList_'+kind+' [data-install-builtins]')?.addEventListener('click',async()=>{try{await req('/mobile/builtins/install',{method:'POST',body:{},timeoutMs:60000});await renderPlusTools(kind);toast(I('added'))}catch(e){toast(e.message)}});$$(`#plusList_${kind} [data-plus-tool-toggle]`).forEach(b=>b.onclick=async()=>{const enabled=!b.classList.contains('on'),path=b.dataset.kind==='skill'?'/mobile/skills/toggle':'/mobile/tools/toggle';try{await req(path,{method:'POST',body:{name:b.dataset.plusToolToggle,enabled},timeoutMs:45000});await renderPlusTools(kind)}catch(e){toast(e.message)}});$$(`#plusList_${kind} [data-plus-edit]`).forEach(b=>b.onclick=()=>{const x=items.find(v=>v.name===b.dataset.plusEdit);if(kind==='skills')editSkill(b.dataset.plusEdit,kind);else toolEditor(x||null,kind)});$$(`#plusList_${kind} [data-plus-delete]`).forEach(b=>b.onclick=()=>confirmDelete(kind==='skills'?'skill':'mcp',b.dataset.plusDelete,kind));$$(`#plusList_${kind} [data-plus-add]`).forEach(b=>b.onclick=()=>{if(kind==='skills')editSkill('',kind);else toolEditor(null,kind)})}catch(e){box.innerHTML=`<div class=sub>${esc(e.message)}</div>`}}
80:async function openAddSheet(){const c=cur();openSheet(`<h2>${I('plusMenu')}</h2><div class=sub>${I('plusExplain')}</div>${plusSection('project','▣',I('project'),projectSummaryBody(),true,projectName())}${plusSection('swarm','◈',I('swarm'),`<div id=plusSwarm><div class=field><label>${I('swarmObjective')}</label><textarea id=swarmObjective rows=2 placeholder="${I('swarmObjectiveHint')}"></textarea></div><div class=row><button class="btn primary grow" id=swarmStartBtn>◈ ${I('startSwarm')}</button><button class="btn bad" id=swarmCancelBtn style="display:none">${I('swarmCancel')}</button></div><div id=swarmStatus class=sub>${I('loading')}…</div><div id=swarmHistory></div></div>`,false,I('swarmHint'))}${plusSection('tools','⌘',I('tools'),`<div id=plusList_tools class=sub>${I('quickOpen')}</div>`,false,I('toolSub'))}${plusSection('plugins','⬡',I('plugins'),`<div id=plusList_plugins class=sub>${I('quickOpen')}</div>`,false,I('workflowPlugins'))}${plusSection('skills','✦',I('skills'),`<div id=plusList_skills class=sub>${I('quickOpen')}</div>`,false,I('builtIn'))}${plusSection('prompt','≡',I('systemInstructions'),`<div class=field><textarea id=plusSystemPrompt rows=7 placeholder="${I('systemPromptHint')}"></textarea></div><div class=row><button class=btn id=plusLoadPrompt>${I('load')}</button><button class="btn primary" id=plusSavePrompt>${I('saveAndClose')}</button></div>`,false,I('systemPromptHint'))}${plusSection('workflow','✓',I('verify')+' / '+I('rounds'),`<div class=sheetRow><span>↻</span><div class=grow><b>${I('rounds')}</b><small>${I('roundsHint')}</small></div><button class="switch ${state.workflows.rounds?'on':''}" data-flow-toggle="rounds"></button></div><div class=sheetRow><span>✓</span><div class=grow><b>${I('verify')}</b><small>${I('verifyHint')}</small></div><button class="switch ${state.workflows.verify?'on':''}" data-flow-toggle="verify"></button></div><div class=sheetRow><span>⛔</span><div class=grow><b>${I('aiGuard')}</b><small>${I('aiGuardHint')}</small></div><button class="switch ${state.aiGuard?'on':''}" data-flow-toggle="guard"></button></div>`,false,'')}`);
