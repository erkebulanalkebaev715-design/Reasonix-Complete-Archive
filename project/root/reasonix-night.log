99:function toolEditor(existing=null,returnKind=''){if(!state.connected){toast(I('needConnection'));return}const kind=returnKind||state.toolTab,plugin=kind==='plugins';openSheet(`<h2>${existing?I('edit'):(plugin?I('addPlugin'):I('addTool'))}</h2><div class=field><label>${I('name')}</label><input id=tn value="${esc(existing?.name||'')}" ${existing?'disabled':''}></div><div class=field><label>${I('transport')}</label><select id=tt>${plugin?'<option value=http>HTTP</option><option value=sse>SSE</option>':'<option value=stdio>stdio</option><option value=http>HTTP</option><option value=sse>SSE</option>'}</select></div><div class=field id=tc><label>${I('commandField')}</label><input id=tcmd value="${esc(existing?.command||'')}"></div><div class=field id=ta><label>${I('args')}</label><input id=targs value="${esc(Array.isArray(existing?.args)?existing.args.join(' '):'')}"></div><div class=field id=tu><label>${I('url')}</label><input id=turl value="${esc(existing?.url||'')}"></div><div class=row><button class=btn data-cancel>${I('cancel')}</button><button class="btn primary grow" data-save>${I('save')}</button></div>`);if(existing?.transport)$('#tt').value=existing.transport;const sync=()=>{const st=$('#tt').value==='stdio';$('#tc').style.display=$('#ta').style.display=st?'block':'none';$('#tu').style.display=st?'none':'block'};$('#tt').onchange=sync;sync();$('#sheetBody [data-cancel]').onclick=()=>reopenPlus(kind);$('#sheetBody [data-save]').onclick=async()=>{const o={name:$('#tn').value.trim(),transport:$('#tt').value,autoStart:existing?.enabled!==false,replace:true};if(o.transport==='stdio'){o.command=$('#tcmd').value.trim();o.args=$('#targs').value.trim().split(/\s+/).filter(Boolean)}else o.url=$('#turl').value.trim();try{await req('/mobile/tools',{method:'POST',body:o,timeoutMs:60000});toast(I('saved'));reopenPlus(kind)}catch(e){toast(e.message)}}}
100:async function editSkill(name='',returnKind='skills'){let body='',desc='';if(name)try{const d=(await req('/mobile/skills/detail?name='+encodeURIComponent(name),{timeoutMs:15000})).data||{};body=d.body||'';desc=d.description||''}catch(e){toast(e.message);return}openSheet(`<h2>${name?I('editSkill'):I('addSkill')}</h2><div class=field><label>${I('name')}</label><input id=sn value="${esc(name)}" ${name?'disabled':''}></div><div class=field><label>${I('description')}</label><input id=sd value="${esc(desc)}"></div><div class=field><label>${I('instruction')}</label><textarea id=sb rows=8>${esc(body)}</textarea></div><div class=row><button class=btn data-cancel>${I('cancel')}</button><button class="btn primary grow" data-save>${I('save')}</button></div>`);$('#sheetBody [data-cancel]').onclick=()=>reopenPlus(returnKind);$('#sheetBody [data-save]').onclick=async()=>{const o={name:$('#sn').value.trim(),description:$('#sd').value.trim(),body:$('#sb').value,runAs:'inline',invocation:'auto'};try{await req('/mobile/skills',{method:'POST',body:o,timeoutMs:45000});toast(I('saved'));reopenPlus(returnKind)}catch(e){toast(e.message)}}}
