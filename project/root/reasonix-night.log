102:function renderSettings(){const s=$('#settingsScreen');if(!s)return;const light=localStorage.rx2Theme==='light',a=state.audit,ex=a?.execution||{},orch=a?.orchestrator||{},budget=a?.budget||{};s.innerHTML=`<h1 class=h1>${I('settings')}</h1><div class=sub>${I('integrationHint')}</div><div class=card><h3>${I('connection')}</h3><div class=field><label>${I('address')}</label><input id=baseUrl value="${esc(state.base)}"></div><div class=field><label>${I('token')}</label><input id=token type=password value="${esc(state.token)}"></div><div class=row><button class="btn primary" id=connectBtn>${I('connect')}</button><span id=connText class=grow>${state.connected?I('connected'):I('notConnected')}</span></div></div><div class=card><div class=row><div class=grow><h3>${I('language')}</h3><p>${I('languageHint')}</p></div><select id=langSelect class=btn><option value=ru>Русский</option><option value=en>English</option></select></div></div><div class=card><div class=row><div class=grow><h3>${I('theme')}</h3><p>${I('themeHint')}</p></div><button class=btn id=themeBtn>${light?'☀':'☾'} ${I('change')}</button></div></div><div class=card><div class=row><div class=grow><h3>${I('approvalMode')}</h3><p>${I('approvalHint')}</p></div><select id=approvalSelect class=btn><option value=auto>${I('approvalAuto')}</option><option value=ask>${I('approvalAsk')}</option></select></div></div><div class=card><div class=row><div class=grow><h3>${I('providers')}</h3><p>${I('providersHint')}</p></div><button class=btn id=providerBtn>${I('add')}</button></div></div><div class=card><div class=row><div class=grow><h3>${I('diagnostics')}</h3><p>${I('integrationHint')}</p></div><button class=btn id=auditBtn>${I('refresh')}</button></div>${auditHtml(a,ex,orch,budget)}</div><div class=card><h3>${I('version')}</h3><p>${I('backendTarget')}: reasonix-mobile-v1.5.0 · 127.0.0.1:37914 · APK v3.0.0</p><p style="margin-top:8px">${I('systemPrompt')}, ${I('tools')}, ${I('plugins')}, ${I('skills')}, ${I('rounds')} и ${I('verify')} перенесены в ＋.</p></div>`;$('#langSelect').value=state.lang;$('#langSelect').onchange=()=>{state.lang=$('#langSelect').value;localStorage.rx2Lang=state.lang;renderStatic()};$('#themeBtn').onclick=()=>{setTheme(light?'dark':'light');renderSettings()};$('#connectBtn').onclick=connect;$('#approvalSelect').value=state.approvalMode;$('#approvalSelect').onchange=async()=>{state.approvalMode=$('#approvalSelect').value;localStorage.rx2ApprovalMode=state.approvalMode;if(state.connected)try{await req('/tool-approval-mode',{method:'POST',body:{mode:state.approvalMode}})}catch(e){toast(e.message)}};$('#providerBtn').onclick=providerEditor;$('#auditBtn').onclick=refreshAudit}
103:function auditHtml(a,ex,orch,budget){const bool=v=>v?I('on'):I('off');return `<div class=auditGrid style="margin-top:11px"><div class=auditCell><b>${I('backend')}</b><small>${state.connected?I('on'):I('off')}</small></div><div class=auditCell><b>${I('balance')}</b><small>${esc(a?.modVersion||I('unknown'))}</small></div><div class=auditCell><b>${I('executionRouter')}</b><small>${bool(!!ex.enabled)}${ex.configured===false?' · '+I('notConfigured'):''}</small></div><div class=auditCell><b>${I('orchestrator')}</b><small>${bool(!!(orch.automaticDispatch||orch.config?.enabled))}</small></div><div class=auditCell><b>${I('approvalBridge')}</b><small>${bool(!!a?.approvalBridge?.approve)}</small></div><div class=auditCell><b>${I('budget')}</b><small>${bool(!!budget.enabled)}</small></div></div>${a?.warnings?.length?`<div class=repeatWarn>${a.warnings.map(w=>/Execution Router/i.test(w)?I('autoUnavailable'):esc(w)).join('<br>')}</div>`:''}`}
