+def adb_status():
+    # Truthful ADB availability: the binary existing is not a device being
+    # connected, and a connection is not authorization. All three are reported
+    # separately and never conflated.
+    adb=which('adb')
+    out={'binary':bool(adb),'path':adb,'devices':[],'connected':False,'authorized':False}
+    if not adb:return out
+    r=run([adb,'devices'])
+    if r['exitCode']!=0:return out
+    for ln in r['stdout'].splitlines():
+        ln=ln.strip()
+        if not ln or ln.startswith('*') or 'daemon' in ln or 'List of devices' in ln:continue
+        parts=ln.split()
+        if len(parts)>=2:
+            state=parts[1].lower();out['devices'].append({'serial':parts[0],'state':state})
+            if state=='device':
+                out['connected']=True;out['authorized']=True
+            elif state in ('unauthorized','offline'):
+                out['connected']=True
+    return out
