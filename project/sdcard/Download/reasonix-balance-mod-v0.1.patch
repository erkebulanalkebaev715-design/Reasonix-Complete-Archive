diff --git a/scripts/balance_mod_smoke.sh b/scripts/balance_mod_smoke.sh
new file mode 100755
index 0000000..65aa383
--- /dev/null
+++ b/scripts/balance_mod_smoke.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+GO_BIN="${GO_BIN:-go}"
+
+cd "$ROOT"
+echo "[1/4] Unit tests: Balance Mod core"
+GOTOOLCHAIN=local "$GO_BIN" test ./internal/efficiency ./internal/provider/mock
+
+echo "[2/4] Build CLI only (skip example plugin)"
+mkdir -p bin
+GOTOOLCHAIN=local CGO_ENABLED=0 "$GO_BIN" build -o bin/reasonix ./cmd/reasonix
+
+TMP="$(mktemp -d)"
+cleanup() { rm -rf "$TMP"; }
+trap cleanup EXIT
+printf 'print("TEST OK")\n' > "$TMP/hello.py"
+cat > "$TMP/reasonix.toml" <<'TOML'
+default_model = "balance-mock"
+
+[[providers]]
+name = "balance-mock"
+kind = "mock"
+model = "smoke"
+base_url = "http://127.0.0.1"
+context_window = 1000000
+price = { cache_hit = 0, input = 0, output = 0, currency = "KZT" }
+
+[environment]
+offline = true
+
+[sandbox]
+bash = "off"
+TOML
+
+echo "[3/4] Offline mock tool-loop"
+cd "$TMP"
+OUT="$($ROOT/bin/reasonix run --model balance-mock --max-steps 6 "Run the offline Balance Mod smoke scenario." 2>&1 || true)"
+printf '%s\n' "$OUT"
+if ! grep -q 'OFFLINE_MOCK_PASS' <<<"$OUT"; then
+  echo "BALANCE_MOD_SMOKE_FAIL: mock provider did not reach final pass" >&2
+  exit 1
+fi
+
+echo "[4/4] PASS — no provider API key/network was used"
+echo "BALANCE_MOD_SMOKE_PASS"
